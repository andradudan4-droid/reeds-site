{
  "name": "reeds-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "drop-trailing-slash"
  },
  // LIVE: enquiries go to Rob, sent with the Reeds Resend key.
  "vars": {
    "NOTIFY_TO": "rcr.plastering@gmx.com",
    "RESEND_FROM": "R. Reeds Plastering & Decorating <leads@reedsplasteranddecor.co.uk>",
    "DRY_RUN": "0"
  },
  "ratelimits": [
    { "name": "CHAT_LIMIT", "namespace_id": "2201", "simple": { "limit": 30, "period": 60 } },
    { "name": "LEAD_LIMIT", "namespace_id": "2203", "simple": { "limit": 5, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
